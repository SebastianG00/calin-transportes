{
  "name": "@tp/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env --import tsx supabase/seed.ts",
    "migrate": "node --env-file=.env --import tsx supabase/migrate.ts",
    "create-bucket": "node --env-file=.env --import tsx supabase/create-bucket.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tp/types": "*",
    "express": "^4.19.2",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.2.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "qrcode": "^1.5.4",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
